class Demo :
    a=10
    b=20
    def __init__(self,c,d) :
         self.c=c
         self.d=d
    def display(self):
         print(self.c,self.d)
    def ch_c(self,c):
        self.c=c
    @classmethod
    def disp(cls):
         print(cls.c,cls.b)
    @staticmethod
    def msg():
        print('print Access specifier')
user=Demo(10,20)
user.display()
user.ch_c(40)
user.display()
user.msg()